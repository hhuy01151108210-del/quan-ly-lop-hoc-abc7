<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hệ Thống Thi Đua Lớp Học</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
    body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f8fafc; }
    .neo-card { background: #ffffff; box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.05); border: 1px solid #f1f5f9; }
    .neo-btn { transition: all 0.2s ease; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2); }
    .neo-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(99, 102, 241, 0.3); }
  </style>
</head>
<body class="text-slate-700 min-h-screen pb-24">

  <!-- HEADER MỚI -->
  <header class="bg-indigo-600 text-white shadow-lg sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-wrap justify-between items-center gap-4">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-white/15 flex items-center justify-center backdrop-blur-md">
          <i data-lucide="award" class="w-7 h-7 text-yellow-300"></i>
        </div>
        <div>
          <h1 class="text-xl font-extrabold tracking-tight">Sổ Thi Đua Lớp Học</h1>
          <p id="role-badge" class="text-xs text-indigo-200 font-medium mt-0.5">Trạng thái: Khách (Xem)</p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <button onclick="openLoginModal()" id="login-btn-ui" class="px-5 py-2.5 rounded-full bg-white text-indigo-600 font-bold text-sm shadow-md hover:bg-indigo-50 transition-all flex items-center gap-2">
          <i data-lucide="key-round" class="w-4 h-4"></i>
          <span id="login-text">Đăng Nhập</span>
        </button>
      </div>
    </div>
  </header>

  <!-- NAVIGATION TABS MỚI -->
  <div class="max-w-7xl mx-auto px-4 mt-6">
    <div class="flex flex-wrap gap-2 bg-white p-2 rounded-2xl shadow-sm border border-slate-100">
      <button onclick="switchTab('map')" id="tab-map" class="nav-tab flex-1 min-w-[120px] py-3 px-4 rounded-xl font-bold text-sm flex items-center justify-center gap-2 bg-indigo-600 text-white shadow-md transition-all">
        <i data-lucide="grid" class="w-4 h-4"></i> Sơ Đồ Lớp
      </button>
      <button onclick="switchTab('daily')" id="tab-daily" class="nav-tab flex-1 min-w-[120px] py-3 px-4 rounded-xl font-bold text-sm flex items-center justify-center gap-2 text-slate-600 hover:bg-slate-50 transition-all">
        <i data-lucide="edit-3" class="w-4 h-4"></i> Ghi Nhận Lỗi
      </button>
      <button onclick="switchTab('weekly')" id="tab-weekly" class="nav-tab flex-1 min-w-[120px] py-3 px-4 rounded-xl font-bold text-sm flex items-center justify-center gap-2 text-slate-600 hover:bg-slate-50 transition-all">
        <i data-lucide="bar-chart-3" class="w-4 h-4"></i> Tổng Kết Tuần
      </button>
      <button onclick="switchTab('admin')" id="tab-admin" class="nav-tab hidden flex-1 min-w-[120px] py-3 px-4 rounded-xl font-bold text-sm flex items-center justify-center gap-2 text-rose-600 hover:bg-rose-50 transition-all">
        <i data-lucide="shield" class="w-4 h-4"></i> Quản Trị
      </button>
    </div>
  </div>

  <!-- CONTAINER CHÍNH -->
  <main class="max-w-7xl mx-auto px-4 mt-6">
    
    <!-- THÔNG TIN TUẦN -->
    <div class="neo-card p-5 rounded-3xl mb-6 flex flex-wrap justify-between items-center gap-4 bg-gradient-to-r from-indigo-50 to-white">
      <div class="flex items-center gap-3">
        <button onclick="changeWeek(-1)" class="w-10 h-10 rounded-xl bg-white shadow border border-slate-200 flex items-center justify-center hover:bg-slate-50"><i data-lucide="chevron-left" class="w-5 h-5"></i></button>
        <div>
          <span id="current-week-label" class="font-extrabold text-lg text-indigo-900">Tuần Hiện Tại</span>
          <p id="current-week-range" class="text-xs text-slate-500 font-medium">Tính từ Thứ 2 đến Thứ 6</p>
        </div>
        <button onclick="changeWeek(1)" class="w-10 h-10 rounded-xl bg-white shadow border border-slate-200 flex items-center justify-center hover:bg-slate-50"><i data-lucide="chevron-right" class="w-5 h-5"></i></button>
      </div>

      <div class="flex flex-wrap gap-2 text-xs font-bold">
        <span class="px-3 py-1.5 rounded-xl bg-emerald-100 text-emerald-700">Tốt: 80-100đ</span>
        <span class="px-3 py-1.5 rounded-xl bg-blue-100 text-blue-700">Khá: 60-79đ</span>
        <span class="px-3 py-1.5 rounded-xl bg-amber-100 text-amber-700">Đạt: 50-59đ</span>
        <span class="px-3 py-1.5 rounded-xl bg-rose-100 text-rose-700">Chưa đạt: &lt;50đ</span>
      </div>
    </div>

    <!-- TAB 1: SƠ ĐỒ LỚP -->
    <section id="view-map" class="tab-content space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" id="seating-chart"></div>
    </section>

    <!-- TAB 2: NHẬP / NHẬT KÝ -->
    <section id="view-daily" class="tab-content hidden space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Form nhập -->
        <div id="entry-form-container" class="neo-card p-6 rounded-3xl space-y-4 lg:col-span-1">
          <h2 class="font-extrabold text-base text-indigo-900 flex items-center gap-2">
            <i data-lucide="plus-circle" class="w-5 h-5 text-indigo-600"></i> Nhập Lỗi / Điểm Cộng
          </h2>

          <div id="entry-form-lock" class="hidden p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-800 text-xs font-semibold">
            ⚠️ Chế độ xem. Hãy đăng nhập tài khoản <b>Ban Quản Lý</b> hoặc <b>Admin</b> để ghi nhận điểm.
          </div>

          <form id="record-form" onsubmit="handleRecordSubmit(event)" class="space-y-4">
            <div>
              <label class="block text-xs font-bold text-slate-500 mb-1">Ngày (T2 - T6)</label>
              <input type="date" id="record-date" required class="w-full px-4 py-2.5 rounded-2xl bg-slate-50 border border-slate-200 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-500 mb-1">Học sinh</label>
              <select id="record-student" required class="w-full px-4 py-2.5 rounded-2xl bg-slate-50 border border-slate-200 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500"></select>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-xs font-bold text-slate-500 mb-1">Thời gian</label>
                <select id="record-time" class="w-full px-3 py-2.5 rounded-2xl bg-slate-50 border border-slate-200 text-sm font-semibold">
                  <option value="15 phút đầu giờ">15p đầu giờ</option>
                  <option value="Tiết 1">Tiết 1</option>
                  <option value="Tiết 2">Tiết 2</option>
                  <option value="Tiết 3">Tiết 3</option>
                  <option value="Tiết 4">Tiết 4</option>
                  <option value="Tiết 5">Tiết 5</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-500 mb-1">Môn học</label>
                <select id="record-subject" class="w-full px-3 py-2.5 rounded-2xl bg-slate-50 border border-slate-200 text-sm font-semibold">
                  <option value="Không có">Không môn</option>
                  <option value="Toán">Toán</option>
                  <option value="Văn">Ngữ Văn</option>
                  <option value="Anh">Tiếng Anh</option>
                  <option value="Sử">Lịch Sử</option>
                  <option value="Công nghệ">Công nghệ</option>
                  <option value="Sinh">Sinh học</option>
                  <option value="Tin">Tin học</option>
                  <option value="KTPL">KTPL</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-500 mb-1">Lỗi vi phạm / Điểm cộng</label>
              <select id="record-rule" required class="w-full px-4 py-2.5 rounded-2xl bg-slate-50 border border-slate-200 text-sm font-semibold">
                <optgroup label="🔴 Điểm Trừ">
                  <option value="SD_DIEN_THOAI">Sử dụng điện thoại (-100đ)</option>
                  <option value="DI_HOC_MUON">Đi học muộn (-50đ)</option>
                  <option value="SAI_DONG_PHUC">Sai đồng phục (-50đ)</option>
                  <option value="VI_PHAM_ATGT">Vi phạm ATGT (-50đ)</option>
                  <option value="DOI_CHO">Tự ý đổi chỗ (-50đ)</option>
                  <option value="NGU_TRONG_GIO">Ngủ trong giờ (-40đ)</option>
                  <option value="MAT_TRAT_TU">Mất trật tự trong giờ (-30đ)</option>
                  <option value="KHONG_GHI_BAI">Không ghi bài (-30đ)</option>
                  <option value="RAC_NGAN_BAN">Rác ngăn bàn (-30đ)</option>
                  <option value="GHI_SO_DAU_BAI">Bị ghi sổ đầu bài (-30đ)</option>
                  <option value="VAO_LOP_MUON">Vào lớp muộn (-10đ)</option>
                </optgroup>
                <optgroup label="🟢 Điểm Cộng">
                  <option value="BONUS_6_XUNG_PHONG">6 lần xung phong (+30đ)</option>
                  <option value="BONUS_3_XP_3_DIEM_TOT">3 xung phong + 3 điểm tốt (+30đ)</option>
                  <option value="BONUS_6_DIEM_TOT">6 lần điểm tốt (+30đ)</option>
                  <option value="BONUS_3_DIEM_TOT">3 lần điểm tốt (+15đ)</option>
                  <option value="BONUS_2_XP_1_DIEM_TOT">2 xung phong + 1 điểm tốt (+10đ)</option>
                  <option value="BONUS_3_GIO_TAY">3 lần giơ tay phát biểu (+5đ)</option>
                </optgroup>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-500 mb-1">Ghi chú</label>
              <input type="text" id="record-note" placeholder="Chi tiết..." class="w-full px-4 py-2.5 rounded-2xl bg-slate-50 border border-slate-200 text-sm font-semibold">
            </div>

            <button type="submit" id="btn-submit-record" class="w-full py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold text-sm neo-btn">
              Xác Nhận Lưu
            </button>
          </form>
        </div>

        <!-- Nhật ký -->
        <div class="neo-card p-6 rounded-3xl space-y-4 lg:col-span-2">
          <div class="flex justify-between items-center">
            <h2 class="font-extrabold text-base text-indigo-900 flex items-center gap-2">
              <i data-lucide="file-text" class="w-5 h-5 text-indigo-600"></i> Nhật Ký Tuần Này
            </h2>
            <button onclick="exportCSV()" class="px-4 py-2 rounded-xl bg-emerald-600 text-white font-bold text-xs flex items-center gap-1.5 shadow-sm hover:bg-emerald-700">
              <i data-lucide="download" class="w-4 h-4"></i> Xuất Excel
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-slate-100 text-xs font-extrabold text-slate-400">
                  <th class="py-3 px-2">Ngày</th>
                  <th class="py-3 px-2">Học Sinh</th>
                  <th class="py-3 px-2">Nội Dung</th>
                  <th class="py-3 px-2">Tiết / Môn</th>
                  <th class="py-3 px-2">Điểm</th>
                  <th class="py-3 px-2 text-right">Xóa</th>
                </tr>
              </thead>
              <tbody id="logs-tbody" class="text-sm divide-y divide-slate-50 font-medium"></tbody>
            </table>
          </div>
        </div>

      </div>
    </section>

    <!-- TAB 3: TỔNG KẾT -->
    <section id="view-weekly" class="tab-content hidden space-y-6">
      <div class="neo-card p-6 rounded-3xl space-y-4">
        <h2 class="font-extrabold text-lg text-indigo-900 flex items-center gap-2">
          <i data-lucide="trophy" class="w-6 h-6 text-amber-500"></i> Bảng Xếp Hạng 4 Tổ (T2 - T5)
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="group-rankings"></div>
      </div>

      <div class="neo-card p-6 rounded-3xl space-y-4">
        <h2 class="font-extrabold text-base text-indigo-900">Hạnh Kiểm & Điểm Thi Đua Cá Nhân</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-slate-100 text-xs font-extrabold text-slate-400">
                <th class="py-3 px-2">Họ Tên</th>
                <th class="py-3 px-2">Tổ</th>
                <th class="py-3 px-2">Điểm Trừ</th>
                <th class="py-3 px-2">Điểm Cộng</th>
                <th class="py-3 px-2">Tổng Điểm</th>
                <th class="py-3 px-2">Hạnh Kiểm</th>
              </tr>
            </thead>
            <tbody id="weekly-student-tbody" class="divide-y divide-slate-50 font-medium"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- TAB 4: ADMIN -->
    <section id="view-admin" class="tab-content hidden space-y-6">
      <div class="neo-card p-6 rounded-3xl border border-rose-100 space-y-6">
        <h2 class="font-extrabold text-lg text-rose-600 flex items-center gap-2">
          <i data-lucide="shield-alert" class="w-6 h-6"></i> Khu Vực Quản Trị Hệ Thống
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
            <h3 class="font-bold text-sm text-slate-800">Thêm Học Sinh</h3>
            <input type="text" id="new-student-name" placeholder="Họ và tên..." class="w-full px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-sm font-semibold">
            <select id="new-student-group" class="w-full px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-sm font-semibold">
              <option value="1">Tổ 1</option>
              <option value="2">Tổ 2</option>
              <option value="3">Tổ 3</option>
              <option value="4">Tổ 4</option>
            </select>
            <button onclick="addStudentAdmin()" class="w-full py-2.5 bg-indigo-600 text-white font-bold rounded-xl text-sm shadow">Thêm Học Sinh</button>
          </div>

          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
            <h3 class="font-bold text-sm text-slate-800">Dữ Liệu & Sao Lưu</h3>
            <button onclick="exportBackupData()" class="w-full py-2.5 bg-slate-800 text-white font-bold rounded-xl text-sm shadow">Tải File Backup JSON</button>
            <button onclick="resetAllData()" class="w-full py-2.5 bg-rose-600 text-white font-bold rounded-xl text-sm shadow">Xóa Toàn Bộ Dữ Liệu</button>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- MODAL ĐĂNG NHẬP -->
  <div id="login-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm hidden">
    <div class="neo-card p-6 rounded-3xl max-w-sm w-full mx-4 space-y-4 bg-white">
      <div class="flex justify-between items-center">
        <h3 class="font-extrabold text-lg text-indigo-900">Xác Thực Truy Cập</h3>
        <button onclick="closeLoginModal()" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <p class="text-xs text-slate-500 leading-relaxed">
        - Ban Quản Lý (GV/Lớp trưởng/Tổ trưởng): PIN <b>123456</b><br>
        - Admin Tối Cao: PIN <b>999999</b>
      </p>
      <input type="password" id="pin-input" placeholder="Mã PIN..." class="w-full px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-center font-mono font-bold tracking-widest text-lg">
      <button onclick="submitLogin()" class="w-full py-3 bg-indigo-600 text-white font-extrabold rounded-2xl text-sm shadow-md">Đăng Nhập Ngay</button>
    </div>
  </div>

  <script>
    const RULES = {
      SD_DIEN_THOAI: { label: 'Sử dụng điện thoại', points: -100 },
      DI_HOC_MUON: { label: 'Đi học muộn', points: -50 },
      SAI_DONG_PHUC: { label: 'Sai đồng phục', points: -50 },
      VI_PHAM_ATGT: { label: 'Vi phạm ATGT', points: -50 },
      DOI_CHO: { label: 'Tự ý đổi chỗ', points: -50 },
      NGU_TRONG_GIO: { label: 'Ngủ trong giờ', points: -40 },
      MAT_TRAT_TU: { label: 'Mất trật tự trong giờ', points: -30 },
      KHONG_GHI_BAI: { label: 'Không ghi bài', points: -30 },
      RAC_NGAN_BAN: { label: 'Rác ngăn bàn', points: -30 },
      GHI_SO_DAU_BAI: { label: 'Bị ghi sổ đầu bài', points: -30 },
      VAO_LOP_MUON: { label: 'Vào lớp muộn', points: -10 },
      
      BONUS_6_XUNG_PHONG: { label: '6 lần xung phong phát biểu', points: 30 },
      BONUS_3_XP_3_DIEM_TOT: { label: '3 xung phong + 3 điểm tốt', points: 30 },
      BONUS_6_DIEM_TOT: { label: '6 lần điểm tốt', points: 30 },
      BONUS_3_DIEM_TOT: { label: '3 lần điểm tốt', points: 15 },
      BONUS_2_XP_1_DIEM_TOT: { label: '2 xung phong + 1 điểm tốt', points: 10 },
      BONUS_3_GIO_TAY: { label: '3 lần giơ tay phát biểu', points: 5 }
    };

    const DEFAULT_STUDENTS = [
      { id: 'hs_1', name: 'Nguyễn Văn An', group: 1 },
      { id: 'hs_2', name: 'Trần Thị Bình', group: 1 },
      { id: 'hs_3', name: 'Lê Hoàng Cường', group: 2 },
      { id: 'hs_4', name: 'Phạm Minh Đức', group: 2 },
      { id: 'hs_5', name: 'Hoàng Anh Dũng', group: 3 },
      { id: 'hs_6', name: 'Vũ Thị Hoa', group: 3 },
      { id: 'hs_7', name: 'Đặng Quốc Khánh', group: 4 },
      { id: 'hs_8', name: 'Bùi Phương Linh', group: 4 }
    ];

    let currentRole = 'GUEST';
    let students = JSON.parse(localStorage.getItem('app_students')) || DEFAULT_STUDENTS;
    let logs = JSON.parse(localStorage.getItem('app_logs')) || [];
    let currentWeekOffset = 0;

    document.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      document.getElementById('record-date').valueAsDate = new Date();
      renderStudentSelect();
      updateWeekRangeDisplay();
      renderAll();
    });

    function getWeekRange(offset = 0) {
      const now = new Date();
      const day = now.getDay(); 
      const diffToMonday = now.getDate() - day + (day === 0 ? -6 : 1) + (offset * 7);
      const monday = new Date(now.setDate(diffToMonday));
      const friday = new Date(monday);
      friday.setDate(monday.getDate() + 4);

      return {
        start: monday.toISOString().slice(0, 10),
        end: friday.toISOString().slice(0, 10),
        display: `${monday.getDate()}/${monday.getMonth()+1} - ${friday.getDate()}/${friday.getMonth()+1}`
      };
    }

    function updateWeekRangeDisplay() {
      const range = getWeekRange(currentWeekOffset);
      document.getElementById('current-week-label').innerText = currentWeekOffset === 0 ? 'Tuần Hiện Tại' : `Tuần (${currentWeekOffset > 0 ? '+' : ''}${currentWeekOffset})`;
      document.getElementById('current-week-range').innerText = `Từ ${range.display} (Thứ 2 - Thứ 6)`;
    }

    function changeWeek(offset) {
      currentWeekOffset += offset;
      updateWeekRangeDisplay();
      renderAll();
    }

    function isLogInCurrentWeek(logDate) {
      const range = getWeekRange(currentWeekOffset);
      return logDate >= range.start && logDate <= range.end;
    }

    function getConductRating(points) {
      if (points >= 80) return { label: 'Tốt', color: 'bg-emerald-100 text-emerald-700 border-emerald-200' };
      if (points >= 60) return { label: 'Khá', color: 'bg-blue-100 text-blue-700 border-blue-200' };
      if (points >= 50) return { label: 'Đạt', color: 'bg-amber-100 text-amber-700 border-amber-200' };
      return { label: 'Chưa đạt', color: 'bg-rose-100 text-rose-700 border-rose-200' };
    }

    function openLoginModal() { document.getElementById('login-modal').classList.remove('hidden'); }
    function closeLoginModal() { document.getElementById('login-modal').classList.add('hidden'); }
    
    function submitLogin() {
      const pin = document.getElementById('pin-input').value;
      if (pin === '999999') {
        currentRole = 'ADMIN';
        alert('Đăng nhập Quản Trị thành công!');
      } else if (pin === '123456') {
        currentRole = 'BQL';
        alert('Đăng nhập Ban Quản Lý thành công!');
      } else {
        alert('Sai mã PIN!');
        return;
      }
      closeLoginModal();
      updateRoleUI();
      renderAll();
    }

    function updateRoleUI() {
      const badge = document.getElementById('role-badge');
      const loginText = document.getElementById('login-text');
      const adminTab = document.getElementById('tab-admin');
      const formLock = document.getElementById('entry-form-lock');
      const btnSubmit = document.getElementById('btn-submit-record');

      if (currentRole === 'ADMIN') {
        badge.innerText = 'Trạng thái: 👑 Admin Tối Cao';
        loginText.innerText = 'Đăng Xuất';
        adminTab.classList.remove('hidden');
        formLock.classList.add('hidden');
        btnSubmit.removeAttribute('disabled');
      } else if (currentRole === 'BQL') {
        badge.innerText = 'Trạng thái: ⭐ Ban Quản Lý';
        loginText.innerText = 'Đăng Xuất';
        adminTab.classList.add('hidden');
        formLock.classList.add('hidden');
        btnSubmit.removeAttribute('disabled');
      } else {
        badge.innerText = 'Trạng thái: Khách (Xem)';
        loginText.innerText = 'Đăng Nhập';
        adminTab.classList.add('hidden');
        formLock.classList.remove('hidden');
        btnSubmit.setAttribute('disabled', 'true');
      }
    }

    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.nav-tab').forEach(el => {
        el.classList.remove('bg-indigo-600', 'text-white', 'shadow-md');
        el.classList.add('text-slate-600');
      });

      document.getElementById(`view-${tabId}`).classList.remove('hidden');
      const activeBtn = document.getElementById(`tab-${tabId}`);
      activeBtn.classList.add('bg-indigo-600', 'text-white', 'shadow-md');
      activeBtn.classList.remove('text-slate-600');
    }

    function renderStudentSelect() {
      const select = document.getElementById('record-student');
      select.innerHTML = students.map(s => `<option value="${s.id}">${s.name} (Tổ ${s.group})</option>`).join('');
    }

    function renderAll() {
      renderSeatingChart();
      renderLogs();
      renderWeeklySummary();
      lucide.createIcons();
    }

    function renderSeatingChart() {
      const container = document.getElementById('seating-chart');
      let html = '';

      for (let g = 1; g <= 4; g++) {
        const groupStudents = students.filter(s => s.group === g);
        html += `
          <div class="neo-card p-5 rounded-3xl space-y-3">
            <div class="flex justify-between items-center border-b border-slate-100 pb-2">
              <h3 class="font-extrabold text-sm text-indigo-600">TỔ ${g}</h3>
              <span class="text-xs text-slate-400 font-semibold">${groupStudents.length} học sinh</span>
            </div>
            <div class="space-y-2">
        `;

        groupStudents.forEach(s => {
          const studentLogs = logs.filter(l => l.studentId === s.id && isLogInCurrentWeek(l.date));
          const totalPoints = Math.max(0, 100 + studentLogs.reduce((acc, l) => acc + (RULES[l.ruleKey]?.points || 0), 0));
          const rating = getConductRating(totalPoints);

          html += `
            <div class="p-3 rounded-2xl bg-slate-50 border border-slate-100 flex justify-between items-center">
              <div>
                <p class="font-bold text-sm text-slate-800">${s.name}</p>
                <p class="text-xs text-slate-400">Vi phạm: ${studentLogs.filter(l => RULES[l.ruleKey]?.points < 0).length}</p>
              </div>
              <div class="text-right">
                <span class="text-xs font-extrabold px-2.5 py-1 rounded-xl border block ${rating.color}">${totalPoints}đ</span>
                <span class="text-[10px] text-slate-500 font-bold">${rating.label}</span>
              </div>
            </div>
          `;
        });

        html += `</div></div>`;
      }
      container.innerHTML = html;
    }

    function handleRecordSubmit(e) {
      e.preventDefault();
      if (currentRole === 'GUEST') return alert('Bạn cần đăng nhập để thao tác!');

      const studentId = document.getElementById('record-student').value;
      const date = document.getElementById('record-date').value;
      const time = document.getElementById('record-time').value;
      const subject = document.getElementById('record-subject').value;
      const ruleKey = document.getElementById('record-rule').value;
      const note = document.getElementById('record-note').value;

      logs.unshift({ id: 'log_' + Date.now(), studentId, date, time, subject, ruleKey, note });
      localStorage.setItem('app_logs', JSON.stringify(logs));
      alert('Đã ghi nhận thành công!');
      renderAll();
    }

    function renderLogs() {
      const tbody = document.getElementById('logs-tbody');
      const filteredLogs = logs.filter(l => isLogInCurrentWeek(l.date));

      if (filteredLogs.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="text-center py-6 text-slate-400 font-medium">Chưa có bản ghi nào trong tuần này</td></tr>`;
        return;
      }

      tbody.innerHTML = filteredLogs.map(l => {
        const student = students.find(s => s.id === l.studentId);
        const rule = RULES[l.ruleKey];
        const isBonus = rule.points > 0;

        return `
          <tr class="hover:bg-slate-50">
            <td class="py-3 px-2 text-xs font-semibold">${l.date}</td>
            <td class="py-3 px-2 font-bold text-slate-800">${student ? student.name : 'Đã xóa'}</td>
            <td class="py-3 px-2 text-xs">${rule.label} ${l.note ? `<span class="text-slate-400">(${l.note})</span>` : ''}</td>
            <td class="py-3 px-2 text-xs text-slate-500">${l.time} - ${l.subject}</td>
            <td class="py-3 px-2 font-extrabold text-xs ${isBonus ? 'text-emerald-600' : 'text-rose-600'}">
              ${isBonus ? '+' : ''}${rule.points}đ
            </td>
            <td class="py-3 px-2 text-right">
              ${(currentRole === 'ADMIN' || currentRole === 'BQL') ? `
                <button onclick="deleteLog('${l.id}')" class="p-1.5 text-rose-500 hover:bg-rose-50 rounded-lg">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              ` : ''}
            </td>
          </tr>
        `;
      }).join('');
    }

    function deleteLog(id) {
      if (!confirm('Xóa bản ghi này?')) return;
      logs = logs.filter(l => l.id !== id);
      localStorage.setItem('app_logs', JSON.stringify(logs));
      renderAll();
    }

    function renderWeeklySummary() {
      const rankContainer = document.getElementById('group-rankings');
      let groupScores = [1, 2, 3, 4].map(g => {
        const gStudents = students.filter(s => s.group === g);
        let total = 0;
        gStudents.forEach(s => {
          const sLogs = logs.filter(l => l.studentId === s.id && isLogInCurrentWeek(l.date));
          total += Math.max(0, 100 + sLogs.reduce((acc, l) => acc + (RULES[l.ruleKey]?.points || 0), 0));
        });
        return { group: g, score: gStudents.length ? (total / gStudents.length).toFixed(1) : 0 };
      });

      groupScores.sort((a, b) => b.score - a.score);

      rankContainer.innerHTML = groupScores.map((g, idx) => `
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 flex justify-between items-center">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl flex items-center justify-center font-extrabold text-xs ${idx === 0 ? 'bg-amber-500 text-white shadow-md' : 'bg-slate-200 text-slate-700'}">
              ${idx + 1}
            </span>
            <div>
              <p class="font-extrabold text-sm text-slate-800">Tổ ${g.group}</p>
              <p class="text-xs text-slate-400">Điểm thi đua TB</p>
            </div>
          </div>
          <span class="font-extrabold text-base text-indigo-600">${g.score}đ</span>
        </div>
      `).join('');

      const studentTbody = document.getElementById('weekly-student-tbody');
      studentTbody.innerHTML = students.map(s => {
        const sLogs = logs.filter(l => l.studentId === s.id && isLogInCurrentWeek(l.date));
        const minus = sLogs.filter(l => RULES[l.ruleKey]?.points < 0).reduce((acc, l) => acc + RULES[l.ruleKey].points, 0);
        const plus = sLogs.filter(l => RULES[l.ruleKey]?.points > 0).reduce((acc, l) => acc + RULES[l.ruleKey].points, 0);
        const total = Math.max(0, 100 + minus + plus);
        const rating = getConductRating(total);

        return `
          <tr class="hover:bg-slate-50">
            <td class="py-3 px-2 font-bold text-slate-800">${s.name}</td>
            <td class="py-3 px-2 text-slate-600">Tổ ${s.group}</td>
            <td class="py-3 px-2 text-rose-600 font-extrabold">${minus}đ</td>
            <td class="py-3 px-2 text-emerald-600 font-extrabold">+${plus}đ</td>
            <td class="py-3 px-2 text-indigo-600 font-extrabold text-base">${total}đ</td>
            <td class="py-3 px-2">
              <span class="text-xs font-extrabold px-3 py-1 rounded-xl border ${rating.color}">
                ${rating.label}
              </span>
            </td>
          </tr>
        `;
      }).join('');
    }

    function addStudentAdmin() {
      const name = document.getElementById('new-student-name').value;
      const group = parseInt(document.getElementById('new-student-group').value);
      if (!name) return alert('Nhập tên học sinh!');
      students.push({ id: 'hs_' + Date.now(), name, group });
      localStorage.setItem('app_students', JSON.stringify(students));
      document.getElementById('new-student-name').value = '';
      renderStudentSelect();
      renderAll();
      alert('Thêm học sinh thành công!');
    }

    function exportCSV() {
      let csv = 'Ngay,HocSinh,To,NoiDung,ThoiGian,Mon,Diem\n';
      logs.filter(l => isLogInCurrentWeek(l.date)).forEach(l => {
        const student = students.find(s => s.id === l.studentId);
        const rule = RULES[l.ruleKey];
        csv += `"${l.date}","${student ? student.name : ''}","${student ? student.group : ''}","${rule.label}","${l.time}","${l.subject}","${rule.points}"\n`;
      });
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `BaoCao_${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
    }

    function exportBackupData() {
      const blob = new Blob([JSON.stringify({ students, logs }, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Backup_${new Date().toISOString().slice(0,10)}.json`;
      a.click();
    }

    function resetAllData() {
      if (!confirm('Xóa sạch dữ liệu?')) return;
      localStorage.clear();
      location.reload();
    }
  </script>
</body>
</html>